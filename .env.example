# ==============================================================================
# AURELIS FLEET — Environment Configuration Template
# NOTE: Copy this file to .env and configure values for your local environment.
# DO NOT commit real production credentials to version control.
# ==============================================================================

# Application Core
APP_NAME="Aurelis Fleet Operations"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Database Configuration (PostgreSQL 16)
# Async URL for FastAPI SQLAlchemy async engine
DATABASE_URL="postgresql+asyncpg://aurelis_admin:aurelis_dev_secret@localhost:5432/aurelis_fleet"
# Sync URL for Alembic migrations and CLI scripts
DATABASE_SYNC_URL="postgresql://aurelis_admin:aurelis_dev_secret@localhost:5432/aurelis_fleet"

# Redis Configuration (Redis 7)
REDIS_URL="redis://localhost:6379/0"

# Authentication & Security
# Generate strong 256-bit key: `openssl rand -hex 32`
JWT_SECRET="aurelis_super_secret_dev_key_change_in_production_32char_minimum"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated list or JSON array)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Observability & Logging
LOG_LEVEL="INFO"
LOG_JSON_FORMAT=true
